# TASK-001 has no required environment variables.
#
# Add server-only values without the NEXT_PUBLIC_ prefix and validate them in
# src/server/config/env.ts. Introduce a separate client-side schema only when a
# browser-visible NEXT_PUBLIC_ value is first required.

# Local public values are printed by `pnpm db:start`. They are intentionally
# not validated until an application Supabase client is introduced.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
